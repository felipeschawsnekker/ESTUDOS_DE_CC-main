    private void carregarTabela(){

    DefaultTableModel tabela =
            (DefaultTableModel)
            TabelaMedicos.getModel();

    tabela.setRowCount(0);

    for(Medico m : MedicoController.getListaMedicos()){

        tabela.addRow(new Object[]{
                m.getNome(),
                m.getCrm(),
                m.getIdade(),
                m.getEspecialidade()
        });
    }
}
