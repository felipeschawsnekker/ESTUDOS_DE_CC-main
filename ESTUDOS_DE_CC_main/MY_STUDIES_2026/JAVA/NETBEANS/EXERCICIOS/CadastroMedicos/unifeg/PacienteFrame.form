    private void SalvarBottonActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_SalvarBottonActionPerformed
        

    try {

        // Verifica se os campos estão vazios
        if(MedicoName.getText().trim().isEmpty()
                || MedicoIdade.getText().trim().isEmpty()
                || MedicoCRM.getText().trim().isEmpty()) {

            JOptionPane.showMessageDialog(
                    this,
                    "Preencha todos os campos."
            );

            return;
        }

        // Caixa de confirmação
       Object[] opcoes = {"Sim","Não"};

int resposta = JOptionPane.showOptionDialog(
        this,
        "Tem certeza que deseja salvar?",
        "Confirmação",
        JOptionPane.YES_NO_OPTION,
        JOptionPane.QUESTION_MESSAGE,
        null,
        opcoes,
        opcoes[0]
);

        // Se clicar em SIM
        if(resposta == JOptionPane.YES_OPTION) {

            // Captura os dados
            String nome = MedicoName.getText();

            int idade = Integer.parseInt(
                    MedicoIdade.getText()
            );

            String crm = MedicoCRM.getText();

            String especialidade =
                    MedicoEspecialidade
                    .getSelectedItem()
                    .toString();

            // Cria controller
            MedicoController controller =
                    new MedicoController();

            // Realiza cadastro
            controller.cadastrarMedico(
                    nome,
                    idade,
                    crm,
                    especialidade
            );

            // Mensagem sucesso
            JOptionPane.showMessageDialog(
                    this,
                    "Cadastro realizado com sucesso!"
            );
            // MODELO DA TABELA
            DefaultTableModel tabela =(DefaultTableModel)TabelaMedicos.getModel();

// ADICIONA LINHA
            tabela.addRow(new Object[] {nome,crm,idade,especialidade});
            // Limpa os campos
            MedicoName.setText("");
            MedicoCRM.setText("");
            MedicoIdade.setText("");

// Volta ComboBox para primeira opção
            MedicoEspecialidade.setSelectedIndex(0);

// Cursor volta para campo nome
            MedicoName.requestFocus();
        }

    } catch(NumberFormatException e) {

        // Caso digite texto na idade
        JOptionPane.showMessageDialog(
                this,
                "Digite apenas números na idade."
        );

    } catch(Exception e) {

        JOptionPane.showMessageDialog(
                this,
                e.getMessage()
        );
    }
    }//GEN-LAST:event_SalvarBottonActionPerformed

